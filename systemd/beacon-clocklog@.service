[Unit]
Description=beacon clocklog (%i): log this host's clock evidence at source rate to /run/beacon-clocklog rings and the timehat DB
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
Environment=ROLE=%i
ExecStart=/usr/bin/python3 /usr/local/bin/clocklog.py
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
