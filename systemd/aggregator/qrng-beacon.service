# k3 (aggregator user, systemd --user, linger on). Started ~40 s before the hour by qrng-beacon.timer: prepares, then wakes at
# :00:00.000 on the aggregator's PTP-disciplined clock and mints (CADENCE.md §2). Install: ~/.config/systemd/user/
[Unit]
Description=qrng-beacon: tick-started commit->publish->reveal->publish cycle (prepare before the hour, wake on it)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/qrng-beacon
Environment=BEACON_RPC=agentd
ExecStart=/usr/bin/python3 %h/qrng-beacon/beacon-cycle.py --at next
TimeoutStartSec=1500
